FROM nginx:alpine

COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf

# Nginx n'execute pas le PHP, mais il a besoin que public/ existe sur son
# disque pour que try_files tranche. Le code embarque ici plutot que partage
# par un volume : un volume conserverait l'ancien code a la mise a jour.
COPY public /var/www/html/public

RUN sed -i 's/^\s*server_tokens.*$//' /etc/nginx/nginx.conf \
    && sed -i '/http {/a \    server_tokens off;' /etc/nginx/nginx.conf

EXPOSE 80
